Windows Registry Editor Version 5.00

; INSTALL policy for Chrome on Windows.
; Deploy via GPO, Intune (script or ADMX-backed policy), or your RMM.
; Replace EXTENSION_ID and https://YOUR_HOST/updates.xml first.
; The "1" value name is an index; use the next free number if the
; forcelist already has entries.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"1"="EXTENSION_ID;https://YOUR_HOST/updates.xml"

; ExtensionSettings with override_update_url is what makes the browser
; actually poll your updates.xml for NEW versions; the forcelist alone
; installs but does not reliably update self-hosted extensions. The value
; is a JSON string; replace EXTENSION_ID and the URL.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"ExtensionSettings"="{\"EXTENSION_ID\":{\"installation_mode\":\"force_installed\",\"update_url\":\"https://YOUR_HOST/updates.xml\",\"override_update_url\":true}}"
