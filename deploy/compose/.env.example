# Copy to .env and fill in. Nothing here is a secret: secrets live in files
# under secrets/, because an environment variable is visible in
# `docker inspect`, in /proc and in every child process's environment.
#
#     cp .env.example .env
#     mkdir -p secrets
#     openssl rand -hex 32 > secrets/auth_token
#     openssl rand -hex 24 > secrets/portal_password
#     chmod 700 secrets && chmod 640 secrets/*
#     sudo chown :65532 secrets/*     # the uid both images run as

# --------------------------------------------------------------------- images

# Pin this. `latest` moves when a release is tagged, which means an unattended
# `docker compose pull` can change what you are running without you choosing
# to. Set it to a released version and bump it deliberately.
IMAGE_TAG=latest

# ------------------------------------------------------------------ log store

# Where the receiver pushes findings. This is the full push endpoint, not the
# base URL: Loki's is /loki/api/v1/push, and posting to the root returns 404.
# With the with-logs profile that is:
#
#     LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
#
# Leave empty to write to stdout only and let your own agent scrape the
# container logs, which is the right answer if you already run Promtail,
# Alloy, Fluent Bit or similar.
LOKI_PUSH_URL=

# Where the portal reads findings back from. Required if you run the portal.
# This one IS the base URL - the portal appends the query path itself. The same
# Loki the receiver writes to, reachable from inside the container: with the
# with-logs profile that is http://loki:3100.
LOKI_URL=

# If your Loki needs a bearer token for reads, put it in a file and point at
# the path INSIDE the container. You will need to mount it yourself.
LOKI_TOKEN_FILE=

# Basic auth for the receiver's writes. Grafana Cloud and most hosted Loki
# need these; a self-hosted one usually does not. Leave both empty to send no
# credentials, which is not the same as sending empty ones.
#
# The password supports the _FILE convention: set LOKI_PASSWORD_FILE to a path
# instead and mount it, rather than putting the value here.
LOKI_USERNAME=
LOKI_PASSWORD=

# ------------------------------------------------------------------- alerting

# Optional. Personal-account findings post here. Empty disables alerting; the
# findings are still recorded.
ALERTMANAGER_URL=

# --------------------------------------------------------------------- portal

# The portal refuses to start without authentication: it names who runs what on
# which machine. The password comes from secrets/portal_password.
PORTAL_USER=admin

# How far back the portal looks, and how long a derived graph is reused. The
# default cache means a seven-day query is not rerun on every page load.
LOOKBACK_HOURS=168
CACHE_TTL_SECONDS=300

# Optional. A CSV of key,identity attaching people to devices, where the key is
# a device identifier or a local username. Path INSIDE the container; mount it
# yourself. This associates named people with the machines they use, so it is
# personal data: keep it wherever you keep deployment configuration, not in a
# repository. The portal can propose one at /api/suggest-identities?fmt=csv.
IDENTITY_MAP=

# ------------------------------------------------------- Grafana in the portal

# Optional. The Dashboard tab embeds panels from here. This is the URL a
# BROWSER reaches Grafana on, not the one the portal container would use, since
# the browser loads the frames.
GRAFANA_URL=

# dashboardUid:panelId:Title, separated by semicolons. Semicolons because panel
# titles contain commas: "Top tools (devices, 7d)" splits into two broken
# entries otherwise. The title is the frame's accessible name, not a caption.
GRAFANA_PANELS=

# Or embed a whole dashboard in one frame, which needs no panel ids and
# survives someone rearranging them.
GRAFANA_DASHBOARD_UID=

# ---------------------------------------------------------------------- ports

# Loopback only. Put a reverse proxy in front rather than changing the bind
# address: the receiver needs to be reachable by endpoints off your network,
# and that means TLS and a certificate.
RECEIVER_PORT=8080
PORTAL_PORT=8091

# ------------------------------------------------------------------- optional

# Timezone for human-readable timestamps in alerts.
DISPLAY_TZ=UTC

# ----------------------------------------------- only with --profile with-logs

# Ignore these unless you have no log store and are using the bundled Loki and
# Grafana. If you already run either, do not start the profile.
GRAFANA_ADMIN_PASSWORD=

# Grafana refuses to be framed by default, deliberately. Set both to embed
# panels in the portal, and understand what you are turning off first: framing
# a session someone is logged into is how clickjacking works.
GRAFANA_ALLOW_EMBEDDING=false
GRAFANA_COOKIE_SAMESITE=lax
